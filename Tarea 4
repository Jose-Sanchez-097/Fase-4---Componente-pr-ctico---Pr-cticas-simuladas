class Reserva:
    """Clase para juntar a un Cliente con un Servicio."""
    
    def __init__(self, id_reserva, objeto_cliente, objeto_servicio, horas_duracion):
        self._id_reserva = id_reserva
        self._cliente = objeto_cliente
        self._servicio = objeto_servicio
        self._horas_duracion = horas_duracion
        self._estado = "PENDIENTE"  # Al iniciar, la reserva arranca en espera
        self._precio_final = 0.0

    @property
    def id_reserva(self):
        return self._id_reserva

    @property
    def estado(self):
        return self._estado

    def procesar_pago(self, descuento=None):
        """Calcula el costo y confirma la reserva usando bloques Try-Except-Else-Finally."""
        try:
            logging.info(f"Intentando procesar la reserva {self._id_reserva}...")
            
            # Intentamos calcular el costo usando el polimorfismo del servicio
            self._precio_final = self._servicio.calcular_total(self._horas_duracion, descuento)
            
        except ErrorServicioNoDisponible as error_origen:
            # Si el servicio arrojó un error de horas, cambiamos el estado de la reserva
            self._estado = "RECHAZADA"
            # Encadenamos el error (from error_origen) para avisar que la reserva falló por culpa del servicio
            raise ErrorReservaInvalida(f"Reserva {self._id_reserva} falló porque el servicio no aceptó los parámetros.") from error_origen
            
        else:
            # El bloque 'else' solo corre si TODO el bloque 'try' salió perfecto sin errores
            self._estado = "CONFIRMADA"
            print(f"[ÉXITO] Reserva {self._id_reserva} Confirmada. Total a pagar: ${self._precio_final:.2f}")
            
        finally:
            # El bloque 'finally' corre SIEMPRE, pase lo que pase (haya error o no)
            logging.info(f"Terminó el proceso de la reserva {self._id_reserva}. Estado final: {self._estado}")

    def cancelar(self):
        """Cancela la reserva si está en el estado correcto."""
        if self._estado == "CANCELADA":
            raise ErrorReservaInvalida("Esta reserva ya estaba cancelada anteriormente.")
        if self._estado != "CONFIRMADA":
            raise ErrorReservaInvalida(f"No puedes cancelar una reserva que no esté CONFIRMADA. Estado actual: {self._estado}")
        
        self._estado = "CANCELADA"
        print(f"[INFO] La reserva {self._id_reserva} fue cancelada exitosamente.")


