# SIMULACIÓN EN VIVO (Las 10 Operaciones Requeridas)
# =====================================================================

def ejecutar_programa():
    print("=== INICIANDO SISTEMA DE SOFTWARE FJ ===\n")
    logging.info("=== NUEVA CORRIDA DEL PROGRAMA ===")

    # Listas/Diccionarios internos para simular que tenemos una base de datos en memoria volatil
    mis_clientes = {}
    mis_servicios = {}
    mis_reservas = {}

    # -----------------------------------------------------------------
    # Operación 1: Crear un cliente bien hecho (Éxito)
    # -----------------------------------------------------------------
    try:
        c1 = Cliente("CLI-10", "Juan Pérez", "juan@correo.com")
        mis_clientes[c1.id_cliente] = c1
        print(f"Op 1: Cliente registrado -> {c1.mostrar_informacion()}")
    except ErrorBaseProyecto as e:
        print(f"Op 1 Errada: {e}")

    # -----------------------------------------------------------------
    # Operación 2: Crear un cliente mal hecho - Correo sin @ (Fallo Controlado)
    # -----------------------------------------------------------------
    try:
        # Esto va a fallar porque el correo está mal escrito
        c2 = Cliente("CLI-20", "María López", "marialogrez.com")
        mis_clientes[c2.id_cliente] = c2
        print(f"Op 2: Cliente registrado -> {c2.mostrar_informacion()}")
    except ErrorBaseProyecto as e:
        # Guardamos el error en el archivo log para que el administrador lo vea
        logging.error(f"Error en Op 2: {e}")
        print(f"Op 2 [ERROR CONTROLADO]: No se creó el cliente de María porque: {e}")

    # -----------------------------------------------------------------
    # Operación 3: Crear servicio de Sala válido (Éxito)
    # -----------------------------------------------------------------
    try:
        s1 = ReservaSala("SAL-01", "Sala de Juntas VIP", precio_por_hora=40.0, capacidad_personas=8)
        mis_servicios[s1.id_servicio] = s1
        print(f"Op 3: Servicio creado -> {s1.nombre_servicio}")
    except ErrorBaseProyecto as e:
        print(f"Op 3 Errada: {e}")

    # -----------------------------------------------------------------
    # Operación 4: Crear servicio de Equipo inválido - Precio Negativo (Fallo Controlado)
    # -----------------------------------------------------------------
    try:
        # Va a fallar porque pusimos -5.0 de precio por hora
        s2 = AlquilerEquipo("EQ-01", "Laptop Gamer", precio_por_hora=-5.0, valor_seguro=10.0)
        mis_servicios[s2.id_servicio] = s2
        print(f"Op 4: Servicio creado -> {s2.nombre_servicio}")
    except ErrorBaseProyecto as e:
        logging.error(f"Error en Op 4: {e}")
        print(f"Op 4 [ERROR CONTROLADO]: El catálogo rechazó el equipo porque: {e}")

    # -----------------------------------------------------------------
    # Operación 5: Crear una reserva de Sala válida por 5 horas (Éxito)
    # -----------------------------------------------------------------
    try:
        cliente_ok = mis_clientes.get("CLI-10")
        servicio_ok = mis_servicios.get("SAL-01")
        
        r1 = Reserva("RES-100", cliente_ok, servicio_ok, horas_duracion=5)
        # Procesamos la reserva aplicando un 10% de descuento (0.10)
        r1.procesar_pago(descuento=0.10)
        mis_reservas[r1.id_reserva] = r1
    except ErrorBaseProyecto as e:
        print(f"Op 5 Errada: {e}")

    # -----------------------------------------------------------------
    # Operación 6: Crear una reserva de Sala inválida - 20 horas (Fallo Controlado)
    # -----------------------------------------------------------------
    try:
        cliente_ok = mis_clientes.get("CLI-10")
        servicio_ok = mis_servicios.get("SAL-01")
        
        # 20 horas rompe la regla de máximo 12 horas para salas físicas
        r2 = Reserva("RES-200", cliente_ok, servicio_ok, horas_duracion=20)
        r2.procesar_pago()
        mis_reservas[r2.id_reserva] = r2
    except ErrorReservaInvalida as e:
        logging.error(f"Error en Op 6 (Encadenado): {e}")
        print(f"Op 6 [ERROR CONTROLADO]: El sistema bloqueó la reserva. Razón: {e}")
        if e.__cause__:
            print(f"   -> Causa raíz que detectó el servicio: {e.__cause__}")

    # -----------------------------------------------------------------
    # Operación 7: Crear servicio de Asesoría válido (Éxito)
    # -----------------------------------------------------------------
    try:
        s3 = AsesoriaEspecializada("ASE-01", "Asesoría de Ciberseguridad", precio_por_hora=100.0, nombre_consultor="Ing. Ana")
        mis_servicios[s3.id_servicio] = s3
        print(f"Op 7: Servicio creado -> {s3.nombre_servicio}")
    except ErrorBaseProyecto as e:
        print(f"Op 7 Errada: {e}")

    # -----------------------------------------------------------------
    # Operación 8: Crear una reserva de Asesoría válida por 3 horas sin descuento (Éxito)
    # -----------------------------------------------------------------
    try:
        cliente_ok = mis_clientes.get("CLI-10")
        servicio_ase = mis_servicios.get("ASE-01")
        
        r3 = Reserva("RES-300", cliente_ok, servicio_ase, horas_duracion=3)
        # No le pasamos el parámetro opcional de descuento, calcula el precio normal + 10% de impuesto
        r3.procesar_pago()
        mis_reservas[r3.id_reserva] = r3
    except ErrorBaseProyecto as e:
        print(f"Op 8 Errada: {e}")

    # -----------------------------------------------------------------
    # Operación 9: Intentar cancelar la Reserva que fue rechazada (Fallo Controlado)
    # -----------------------------------------------------------------
    try:
        # Buscamos la reserva RES-200 de la Op 6 que se quedó en estado "RECHAZADA"
        reserva_mala = mis_reservas.get("RES-200")
        if not reserva_mala:
            raise ErrorReservaInvalida("La reserva RES-200 no está registrada como activa en el sistema.")
        reserva_mala.cancelar()
    except ErrorReservaInvalida as e:
        logging.error(f"Error en Op 9: {e}")
        print(f"Op 9 [ERROR CONTROLADO]: No se pudo cancelar porque: {e}")

    # -----------------------------------------------------------------
    # Operación 10: Cancelar una Reserva activa y confirmada (Éxito)
    # -----------------------------------------------------------------
    try:
        # Cancelamos la reserva exitosa RES-100 de la Operación 5
        reserva_buena = mis_reservas.get("RES-100")
        reserva_buena.cancelar()
    except ErrorBaseProyecto as e:
        print(f"Op 10 Errada: {e}")

    print("\n=== SIMULACIÓN FINALIZADA SIN ERRORES CRÍTICOS ===")
    print("La aplicación nunca se cerró de golpe gracias a los bloques Try/Except.")

# Arrancar la simulación de inmediato
if __name__ == "__main__":
    ejecutar_programa()
