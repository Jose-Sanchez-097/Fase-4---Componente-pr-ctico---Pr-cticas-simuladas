# ==========================================
# EXCEPCIONES PERSONALIZADAS (Manejo de Errores)
# ==========================================

class SoftwareFJException(Exception):
    """Excepción base para el sistema Software FJ, hereda de la clase nativa Exception."""
    pass

class ValidacionDatoError(SoftwareFJException):
    """Se lanza cuando un dato de entrada (como cédula, correo, nombre) no cumple el formato."""
    pass

class ServicioNoDisponibleError(SoftwareFJException):
    """Se lanza cuando el servicio solicitado no cumple con las condiciones o parámetros necesarios."""
    pass

class ReservaInvalidaError(SoftwareFJException):
    """Se lanza cuando una operación sobre una reserva (creación, cancelación) viola las reglas de negocio."""
    pass


# ==========================================
# CLASES ABSTRACTAS Y DE ENTIDAD
# ==========================================

class EntidadSistema(abc.ABC):
    """Clase abstracta que representa cualquier entidad con un identificador único en el sistema."""
    
    def __init__(self, id_entidad: str):
        # Encapsulamiento del atributo identificador único.
        self._id_entidad = id_entidad

    @abc.abstractmethod
    def obtener_detalles(self) -> str:
        """Método abstracto que obliga a las subclases a retornar su representación en texto."""
        pass

    @property
    def id_entidad(self) -> str:
        """Getter para acceder de forma segura al identificador único."""
        return self._id_entidad


class Cliente(EntidadSistema):
    """Clase que representa a un cliente de la empresa Software FJ con encapsulación estricta."""
    
    def __init__(self, id_cliente: str, nombre: str, correo: str):
        # Invocamos al constructor de la clase abstracta padre.
        super().__init__(id_cliente)
        
        # Validaciones de inicialización usando los setters encapsulados
        self.nombre = nombre
        self.correo = correo

    # --- Getters y Setters con validaciones de negocio ---
    @property
    def nombre(self) -> str:
        return self._nombre

    @nombre.setter
    def nombre(self, valor: str):
        # El nombre no puede estar vacío ni contener únicamente espacios en blanco.
        if not valor or not valor.strip():
            raise ValidacionDatoError("El nombre del cliente no puede estar vacío.")
        self._nombre = valor.strip()

    @property
    def correo(self) -> str:
        return self._correo

    @correo.setter
    def correo(self, valor: str):
        # Validación básica de estructura de correo electrónico.
        if "@" not in valor or "." not in valor:
            raise ValidacionDatoError(f"El correo electrónico '{valor}' no tiene un formato válido.")
        self._correo = valor.strip()

    def obtener_detalles(self) -> str:
        """Implementación del método abstracto de la clase padre."""
        return f"Cliente ID: {self.id_entidad} | Nombre: {self._nombre} | Email: {self._correo}"


# ==========================================
# JERARQUÍA DE SERVICIOS (Polimorfismo)
# ==========================================

class Servicio(abc.ABC):
    """Clase abstracta que define la estructura obligatoria de cualquier servicio de la empresa."""
    
    def __init__(self, id_servicio: str, nombre_servicio: str, costo_base: float):
        self._id_servicio = id_servicio
        self._nombre_servicio = nombre_servicio
        # Validación: el costo base no puede ser negativo.
        if costo_base < 0:
            raise ValidacionDatoError("El costo base de un servicio no puede ser negativo.")
        self._costo_base = costo_base

    @property
    def id_servicio(self) -> str:
        return self._id_servicio

    @property
    def nombre_servicio(self) -> str:
        return self._nombre_servicio

    @abc.abstractmethod
    def calcular_costo(self, horas: int, descuento: float = None) -> float:
        """Método abstracto polimórfico para calcular los costos del servicio."""
        pass

    @abc.abstractmethod
    def validar_parametros(self, horas: int) -> bool:
        """Método abstracto para comprobar que el uso solicitado sea lógico y viable."""
        pass


class ReservaSala(Servicio):
    """Servicio derivado para el alquiler de salas de juntas o capacitación."""
    
    def __init__(self, id_servicio: str, nombre_servicio: str, costo_base: float, capacidad_personas: int):
        super().__init__(id_servicio, nombre_servicio, costo_base)
        if capacidad_personas <= 0:
            raise ValidacionDatoError("La capacidad de la sala debe ser mayor a cero.")
        self._capacidad_personas = capacidad_personas

    def validar_parametros(self, horas: int) -> bool:
        # Regla de negocio: las salas se alquilan por un mínimo de 2 horas y un máximo de 12 horas.
        if horas < 2 or horas > 12:
            raise ServicioNoDisponibleError(f"Reserva de sala inválida: {horas} horas. Rango permitido: 2-12 hrs.")
        return True

    def calcular_costo(self, horas: int, descuento: float = None) -> float:
        """Implementación polimórfica y sobrecarga simulada de costos."""
        self.validar_parametros(horas)
        costo_total = self._costo_base * horas
        
        # Simulación de sobrecarga: si se envía el parámetro opcional de descuento, se aplica.
        if descuento is not None:
            if not (0 <= descuento <= 1):
                raise ValidacionDatoError("El porcentaje de descuento debe estar entre 0.0 y 1.0.")
            costo_total -= (costo_total * descuento)
            
        return costo_total


class AlquilerEquipo(Servicio):
    """Servicio derivado para el préstamo de hardware y dispositivos tecnológicos."""
    
    def __init__(self, id_servicio: str, nombre_servicio: str, costo_base: float, seguro_obligatorio: float):
        super().__init__(id_servicio, nombre_servicio, costo_base)
        if seguro_obligatorio < 0:
            raise ValidacionDatoError("El costo del seguro no puede ser negativo.")
        self._seguro_obligatorio = seguro_obligatorio

    def validar_parametros(self, horas: int) -> bool:
        # Regla de negocio: los equipos se alquilan por días completos simulados en horas (mínimo 1 hora, máximo 72).
        if horas <= 0 or horas > 72:
            raise ServicioNoDisponibleError(f"Alquiler de equipo inválido: {horas} horas. Rango permitido: 1-72 hrs.")
        return True

    def calcular_costo(self, horas: int, descuento: float = None) -> float:
        """Cálculo de costo incluyendo el costo fijo del seguro obligatorio."""
        self.validar_parametros(horas)
        costo_total = (self._costo_base * horas) + self._seguro_obligatorio
        
        if descuento is not None:
            if not (0 <= descuento <= 1):
                raise ValidacionDatoError("El porcentaje de descuento debe estar entre 0.0 y 1.0.")
            # El descuento solo aplica al valor del alquiler por horas, no al seguro.
            costo_neto = self._costo_base * horas
            costo_total = (costo_neto - (costo_neto * descuento)) + self._seguro_obligatorio
            
        return costo_total


class AsesoriaEspecializada(Servicio):
    """Servicio derivado para consultorías de software y arquitectura técnica."""
    
    def __init__(self, id_servicio: str, nombre_servicio: str, costo_base: float, consultor: str):
        super().__init__(id_servicio, nombre_servicio, costo_base)
        if not consultor or not consultor.strip():
            raise ValidacionDatoError("Debe asignarse un consultor válido a la asesoría.")
        self._consultor = consultor

    def validar_parametros(self, horas: int) -> bool:
        # Regla de negocio: Las asesorías tienen un máximo estricto de 5 horas por sesión.
        if horas <= 0 or horas > 5:
            raise ServicioNoDisponibleError(f"Asesoría inválida: {horas} horas solicitadas. Máximo permitido: 5 hrs.")
        return True

    def calcular_costo(self, horas: int, descuento: float = None) -> float:
        """Cálculo de costo de asesorías aplicando un recargo fijo por impuestos/plataforma del 10%."""
        self.validar_parametros(horas)
        impuesto = 0.10  # 10% de recargo regulatorio.
        costo_base_horas = self._costo_base * horas
        costo_total = costo_base_horas * (1 + impuesto)
        
        if descuento is not None:
            if not (0 <= descuento <= 1):
                raise ValidacionDatoError("El porcentaje de descuento debe estar entre 0.0 y 1.0.")
            # El descuento se netea antes de aplicar el recargo impositivo.
            costo_total = (costo_base_horas * (1 - descuento)) * (1 + impuesto)
            
        return costo_total


# ==========================================
# CLASE DE GESTIÓN DE RESERVAS
# ==========================================

class Reserva:
    """Clase que integra Clientes y Servicios para procesar y gestionar transacciones."""
    
    def __init__(self, id_reserva: str, cliente: Cliente, servicio: Servicio, duracion_horas: int):
        self._id_reserva = id_reserva
        # Verificamos que los objetos pasados pertenezcan a las clases correctas.
        if not isinstance(cliente, Cliente):
            raise ValidacionDatoError("Objeto cliente provisto no es una instancia válida.")
        if not isinstance(servicio, Servicio):
            raise ValidacionDatoError("Objeto servicio provisto no es una instancia válida.")
            
        self._cliente = cliente
        self._servicio = servicio
        self._duracion_horas = duracion_horas
        self._estado = "PENDIENTE"  # Estados: PENDIENTE, CONFIRMADA, CANCELADA.
        self._costo_final = 0.0

    @property
    def id_reserva(self) -> str:
        return self._id_reserva

    @property
    def estado(self) -> str:
        return self._estado

    def procesar_reserva(self, descuento: float = None):
        """Aplica lógica de negocio robusta utilizando bloques avanzados de try/except."""
        try:
            # Flujo principal: se intenta validar los parámetros y calcular el costo.
            logging.info(f"Iniciando procesamiento de la reserva {self._id_reserva}...")
            self._costo_final = self._servicio.calcular_costo(self._duracion_horas, descuento)
            
        except ServicioNoDisponibleError as e:
            # Manejo específico: el servicio rechazó las horas solicitadas.
            self._estado = "RECHAZADA"
            # Encadenamiento de excepciones: lanzamos una nueva excepción explicando el contexto original.
            raise ReservaInvalidaError(f"No se pudo procesar la reserva {self._id_reserva} debido a la indisponibilidad del servicio.") from e
            
        except ValidacionDatoError as e:
            # Manejo específico: datos inconsistentes como descuentos inválidos.
            self._estado = "ERROR_DATOS"
            raise ReservaInvalidaError(f"Error en datos de procesamiento para la reserva {self._id_reserva}.") from e
            
        else:
            # Bloque ELSE: se ejecuta única y exclusivamente si NO ocurrió ninguna excepción en el bloque try.
            self._estado = "CONFIRMADA"
            logging.info(f"Reserva {self._id_reserva} CONFIRMADA exitosamente por un valor de ${self._costo_final:.2f}")
            
        finally:
            # Bloque FINALLY: se ejecuta SIEMPRE, garantizando el cierre de operaciones y log de auditoría.
            logging.info(f"Finalizado el intento de procesamiento del registro {self._id_reserva}. Estado resultante: {self._estado}")

    def cancelar_reserva(self):
        """Cancela una reserva activa si cumple las condiciones del negocio."""
        if self._estado == "CANCELADA":
            raise ReservaInvalidaError(f"La reserva {self._id_reserva} ya se encuentra cancelada.")
        if self._estado == "RECHAZADA" or self._estado == "ERROR_DATOS":
            raise ReservaInvalidaError(f"No se puede cancelar una reserva que no fue confirmada previamente. Estado: {self._estado}")
        
        self._estado = "CANCELADA"
        logging.info(f"La reserva {self._id_reserva} ha sido cancelada por el cliente.")


