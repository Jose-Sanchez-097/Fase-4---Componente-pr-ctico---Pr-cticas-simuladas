# =====================================================================
# MIS PROPIOS ERRORES PERSONALIZADOS
# =====================================================================
# Creamos categorías de errores para saber exactamente qué falló en nuestra app.

class ErrorBaseProyecto(Exception):
    """Es el padre de todos los errores que registraremos abajo."""
    pass

class ErrorDeValidacion(ErrorBaseProyecto):
    """Se usa cuando un dato está mal escrito (ej. correo sin @ o texto vacío)."""
    pass

class ErrorServicioNoDisponible(ErrorBaseProyecto):
    """Se usa cuando alguien pide un servicio pero no cumple las reglas (ej. demasiadas horas)."""
    pass

class ErrorReservaInvalida(ErrorBaseProyecto):
    """Se usa cuando una reserva falla a nivel general o no se puede cancelar."""
    pass


# =====================================================================
# CLASES BASE Y CLASE CLIENTE
# =====================================================================

class EntidadGeneral(abc.ABC):
    """Esta es una plantilla abstracta para cualquier cosa que tenga un ID en el sistema."""
    
    def __init__(self, id_numero):
        self._id_numero = id_numero  # El guion bajo (_) significa que es una variable protegida (privada)

    @abc.abstractmethod
    def mostrar_informacion(self):
        """Cualquier clase que herede de aquí obligatoriamente debe programar este método."""
        pass


class Cliente(EntidadGeneral):
    """Clase para guardar los datos de los clientes."""
    
    def __init__(self, id_cliente, nombre_completo, correo_electronico):
        # Llamamos al constructor de la clase padre (EntidadGeneral) para pasarle el ID
        super().__init__(id_cliente)
        
        # Validamos el nombre antes de guardarlo
        if not nombre_completo or nombre_completo.strip() == "":
            raise ErrorDeValidacion("El nombre no puede estar en blanco.")
        self._nombre_completo = nombre_completo
        
        # Validamos el correo de forma sencilla
        if "@" not in correo_electronico or "." not in correo_electronico:
            raise ErrorDeValidacion(f"El correo '{correo_electronico}' no parece un correo real.")
        self._correo_electronico = correo_electronico

    # Usamos propiedades (getters) para poder leer los datos desde fuera de la clase de forma segura
    @property
    def id_cliente(self):
        return self._id_numero

    @property
    def nombre_completo(self):
        return self._nombre_completo

    def mostrar_informacion(self):
        """Cumplimos con la obligación de la clase abstracta."""
        return f"Cliente: {self._nombre_completo} | Contacto: {self._correo_electronico}"


# =====================================================================
# JERARQUÍA DE SERVICIOS (HERENCIA Y POLIMORFISMO)
# =====================================================================

class Servicio(abc.ABC):
    """Plantilla abstracta para los servicios que vende Software FJ."""
    
    def __init__(self, id_servicio, nombre_servicio, precio_por_hora):
        self._id_servicio = id_servicio
        self._nombre_servicio = nombre_servicio
        
        if precio_por_hora < 0:
            raise ErrorDeValidacion("El precio por hora no puede ser un número negativo.")
        self._precio_por_hora = precio_por_hora

    @property
    def id_servicio(self):
        return self._id_servicio

    @property
    def nombre_servicio(self):
        return self._nombre_servicio

    @abc.abstractmethod
    def calcular_total(self, horas_pedidas, descuento_opcional=None):
        """Cada servicio calculará su precio final a su propia manera."""
        pass


class ReservaSala(Servicio):
    """Subclase 1: Alquiler de salas físicas."""
    
    def __init__(self, id_servicio, nombre_servicio, precio_por_hora, capacidad_personas):
        super().__init__(id_servicio, nombre_servicio, precio_por_hora)
        self._capacidad_personas = capacidad_personas

    def calcular_total(self, horas_pedidas, descuento_opcional=None):
        # Regla de negocio: las salas se alquilan entre 2 y 12 horas máximo
        if horas_pedidas < 2 or horas_pedidas > 12:
            raise ErrorServicioNoDisponible(f"Horas inválidas ({horas_pedidas}). Las salas se alquilan de 2 a 12 horas.")
        
        total = self._precio_por_hora * horas_pedidas
        
        # Simulamos la sobrecarga de métodos: si mandan descuento, lo aplicamos
        if descuento_opcional is not None:
            total = total - (total * descuento_opcional)
            
        return total


class AlquilerEquipo(Servicio):
    """Subclase 2: Alquiler de computadores o servidores."""
    
    def __init__(self, id_servicio, nombre_servicio, precio_por_hora, valor_seguro):
        super().__init__(id_servicio, nombre_servicio, precio_por_hora)
        self._valor_seguro = valor_seguro  # Cobro extra obligatorio por si dañan el equipo

    def calcular_total(self, horas_pedidas, descuento_opcional=None):
        # Regla de negocio: los equipos no se alquilan por más de 3 días (72 horas)
        if horas_pedidas <= 0 or horas_pedidas > 72:
            raise ErrorServicioNoDisponible(f"Tiempo inválido ({horas_pedidas} hrs). Máximo permitido: 72 horas.")
        
        # El precio es el costo de las horas más el seguro obligatorio
        total_horas = self._precio_por_hora * horas_pedidas
        
        if descuento_opcional is not None:
            total_horas = total_horas - (total_horas * descuento_opcional)
            
        return total_horas + self._valor_seguro


class AsesoriaEspecializada(Servicio):
    """Subclase 3: Consultas con ingenieros expertos."""
    
    def __init__(self, id_servicio, nombre_servicio, precio_por_hora, nombre_consultor):
        super().__init__(id_servicio, nombre_servicio, precio_por_hora)
        self._nombre_consultor = nombre_consultor

    def calcular_total(self, horas_pedidas, descuento_opcional=None):
        # Regla de negocio: un consultor no da más de 5 horas de asesoría por sesión
        if horas_pedidas <= 0 or horas_pedidas > 5:
            raise ErrorServicioNoDisponible(f"Las asesorías no pueden durar más de 5 horas. Pediste: {horas_pedidas}.")
        
        # Estas asesorías tienen un recargo del 10% por impuestos de la empresa
        subtotal = self._precio_por_hora * horas_pedidas
        
        if descuento_opcional is not None:
            subtotal = subtotal - (subtotal * descuento_opcional)
            
        total_con_impuesto = subtotal * 1.10  # Multiplicar por 1.10 le suma el 10%
        return total_con_impuesto


